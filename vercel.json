{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/style.css",
      "destination": "/api/index.js"
    },
    {
      "source": "/app.js",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/api/index.js"
    }
  ]
}
