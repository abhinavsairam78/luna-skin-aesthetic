{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "**"
    },
    "server.js": {
      "includeFiles": "**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/((?!.*\\.(css|js|png|jpg|jpeg|svg|gif|ico|json|pdf|woff|woff2|ttf|eot)).*)",
      "destination": "/server.js"
    }
  ]
}
